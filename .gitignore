target/
Cargo.lock.bak
.DS_Store

# Never commit credentials. A secrets.env belonging to another project was
# swept in by `git add -A` once; these patterns make that impossible to repeat
# silently.
secrets.env
*.env
!*.env.example
.envrc
*.pem
*.key

# Downloaded by `just specs` for the coverage check; not ours to vendor.
specs/

# Python bytecode from the scripts/ helpers.
__pycache__/

# AI tooling artifacts: agent worktrees, assistant configs, and scratch notes.
# None of it belongs to the crate, and none of it should reach a published
# tarball or a public diff.
.claude/
.cursor/
.cursorrules
.windsurf/
.windsurfrules
.aider*
.continue/
.codeium/
.gemini/
.roo/
.specstory/
.mcp.json
.github/copilot-instructions.md
nimbalyst-local/
# Tracker type schemas and workspace config. Nothing writes here yet, but
# `tracker_define_type` persists YAML into it the moment a custom type exists.
.nimbalyst/

# Agent instruction files, kept out of the repo for the same reason.
AGENTS.md
CLAUDE.md
GEMINI.md
